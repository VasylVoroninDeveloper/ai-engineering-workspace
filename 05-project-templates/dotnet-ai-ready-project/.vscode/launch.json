{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Template.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/src/Template.Api/bin/Debug/net10.0/Template.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Template.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}